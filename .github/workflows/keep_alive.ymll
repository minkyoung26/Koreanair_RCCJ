name: Keep Streamlit App Alive

on:
  schedule:
    # 6시간마다 실행 (원하는 주기로 변경 가능)
    - cron: '0 */6 * * *'
  workflow_dispatch: # 수동 실행 버튼도 활성화

jobs:
  ping:
    runs-on: ubuntu-latest
    steps:
      - name: Send Ping to Streamlit App
        run: |
          curl -s https://koreanairrccj-marketshare.streamlit.app/ > /dev/null
          echo "Successfully pinged Streamlit app!"
